# ─── Nawa Learn — environment template ────────────────────────────────────────
#
# Copy this file to `.env.local` and fill in real values:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored (see `.gitignore`) and is read by Next.js, by
# `drizzle-kit` (via `drizzle.config.ts`) and by the `src/db/*` scripts.
#
# Never commit a real value to this file. `.env.example` exists so that a new
# contributor can see *which* variables the app needs — not what they are.
#
#   required     the app does not start or cannot sign anyone in without it
#   optional     the feature degrades to a documented fallback
#   injected     set by the hosting platform; do not fill these in by hand
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled endpoint, `sslmode=require`).
# Read by `src/db/index.ts`, the `db:seed` / `db:promote` scripts, and
# `drizzle-kit` for migrations. The app throws at import time without it.
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# Clerk. The publishable key is embedded in the browser bundle (it is public by
# design); the secret key is server-only and must never be exposed to the client.
# Get both from the Clerk dashboard for the matching instance (test vs live).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Svix signing secret for the Clerk webhook (`/api/webhooks/clerk`).
# Without it the handler cannot verify the signature and answers 400.
# Clerk dashboard → Webhooks → your endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET="whsec_..."

# ─── Optional ────────────────────────────────────────────────────────────────

# Vercel Blob read-write token. Avatars and module files live here.
#
#   set    → `POST /api/uploads` stores the object and returns its URL
#   unset  → uploads answer 503 with a loud log. There is deliberately no
#            base64-into-Postgres fallback: that path was the problem.
#
# Create a Blob store in the Vercel dashboard, then copy its token.
# Format: vercel_blob_rw_<storeId>_<secret>
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Upstash Redis REST credentials for the rate limiter (`src/lib/rateLimit.ts`).
#
#   set    → counters are shared across instances; this is required in production
#   unset  → an in-process Map is used, which does NOT stop a distributed flood
#            on serverless. The limiter fails *open* and logs loudly.
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Shared secret for the scheduled jobs (`POST /api/cron/retention`,
# `POST /api/cron/season`). The scheduler has no session, so this bearer token is
# the only gate. Both routes fail *closed*: an unset secret means 401 for
# everyone, never open access.
#
#   set    → Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically
#   unset  → the jobs answer 401 and log `cron_*_misconfigured`; nothing is pruned
#            on schedule and season seats are never reconciled
#
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Transactional email (`src/lib/mailer.ts`). Every message is about the
# recipient's own account: a submission was reviewed, a rare badge unlocked, a
# season ended, a podium seat was granted or revoked. There is no newsletter.
#
#   set    → `enqueueMail()` writes the outbox row and sends immediately
#   unset  → nothing is sent, the row is marked `skipped` and
#            `mail_not_configured` is logged. The caller still succeeds: an
#            approval must never fail because a mail provider is missing.
#
# MAIL_FROM must be an address on a domain you control and have verified with the
# provider (SPF + DKIM). Sending from an unverified domain is rejected by most
# receivers. Here that domain is `nawasena.site`.
RESEND_API_KEY="re_..."
MAIL_FROM="kabar@nawasena.site"

# Absolute origin used by `src/lib/site.ts` for every URL that has to be absolute:
# the sitemap entries, the `Sitemap:` line in robots.txt, `metadataBase` in the
# root layout (which is what makes Open Graph URLs absolute) and the manifest.
#
#   set    → that origin is used verbatim (a custom domain, a staging host)
#   unset  → `VERCEL_PROJECT_PRODUCTION_URL` is used on Vercel, and
#            `http://localhost:3000` everywhere else
#
# Prefer leaving it unset on Vercel: the platform's own variable always points at
# production, even on a preview deployment, which is what a sitemap must say. A
# bare host (`nawa.example.com`) and a full origin (`https://nawa.example.com`)
# are both accepted; the trailing slash is stripped either way.
#
# The `NEXT_PUBLIC_` prefix means Next inlines this at build time, so changing it
# in the dashboard has no effect until the next deployment. That is consistent
# with the rest of this file: robots.txt and sitemap.xml are prerendered, so they
# would need a rebuild to carry a new origin anyway.
# NEXT_PUBLIC_SITE_URL="https://nawa.example.com"

# Minimum log level: debug | info | warn | error.
# Defaults to `info` in production and `debug` everywhere else.
# `debug` also enables the in-memory rate-limit warning.
LOG_LEVEL="debug"

# Opt-in switch for the development seed script only. It writes fake rows, so it
# refuses to run unless this is exactly "1":
#
#   ALLOW_SEED=1 npm run db:seed
#
ALLOW_SEED="0"

# ─── Injected by the platform — do not set these by hand ─────────────────────

# Vercel sets these automatically. `VERCEL_OIDC_TOKEN` is present on Vercel
# deployments, which is exactly why `src/lib/storage.ts` passes
# `BLOB_READ_WRITE_TOKEN` to the SDK explicitly on every call: left to itself the
# SDK prefers OIDC and would pick the store named by `BLOB_STORE_ID` instead.
# BLOB_STORE_ID="store_..."
# VERCEL_OIDC_TOKEN="..."

# The project's production domain, *without* a scheme (`nawa-learn.vercel.app`).
# Vercel sets it on every deployment, previews included, and deliberately points
# at production there. `src/lib/site.ts` reads it as the fallback origin for
# sitemap.xml, robots.txt and `metadataBase`, so a preview never advertises
# itself as the canonical site. Nothing to fill in.
# VERCEL_PROJECT_PRODUCTION_URL="..."

# `NODE_ENV` is set by Next.js itself (`development` / `production`) and drives
# HSTS, log verbosity and the secure-cookie flags. Do not set it manually.
