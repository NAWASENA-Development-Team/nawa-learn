# ─── Nawa Learn — environment template ────────────────────────────────────────
#
# Copy this file to `.env.local` and fill in real values:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored (see `.gitignore`) and is read by Next.js, by
# `drizzle-kit` (via `drizzle.config.ts`) and by the `src/db/*` scripts.
#
# Never commit a real value to this file. `.env.example` exists so that a new
# contributor can see *which* variables the app needs — not what they are.
#
#   required     the app does not start or cannot sign anyone in without it
#   optional     the feature degrades to a documented fallback
#   injected     set by the hosting platform; do not fill these in by hand
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled endpoint, `sslmode=require`).
# Read by `src/db/index.ts`, the `db:seed` / `db:promote` scripts, and
# `drizzle-kit` for migrations. The app throws at import time without it.
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# Clerk. The publishable key is embedded in the browser bundle (it is public by
# design); the secret key is server-only and must never be exposed to the client.
# Get both from the Clerk dashboard for the matching instance (test vs live).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Svix signing secret for the Clerk webhook (`/api/webhooks/clerk`).
# Without it the handler cannot verify the signature and answers 400.
# Clerk dashboard → Webhooks → your endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET="whsec_..."

# ─── Optional ────────────────────────────────────────────────────────────────

# Vercel Blob read-write token. Avatars and module files live here.
#
#   set    → `POST /api/uploads` stores the object and returns its URL
#   unset  → uploads answer 503 with a loud log. There is deliberately no
#            base64-into-Postgres fallback: that path was the problem.
#
# Create a Blob store in the Vercel dashboard, then copy its token.
# Format: vercel_blob_rw_<storeId>_<secret>
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Upstash Redis REST credentials for the rate limiter (`src/lib/rateLimit.ts`).
#
#   set    → counters are shared across instances; this is required in production
#   unset  → an in-process Map is used, which does NOT stop a distributed flood
#            on serverless. The limiter fails *open* and logs loudly.
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Minimum log level: debug | info | warn | error.
# Defaults to `info` in production and `debug` everywhere else.
# `debug` also enables the in-memory rate-limit warning.
LOG_LEVEL="debug"

# Opt-in switch for the development seed script only. It writes fake rows, so it
# refuses to run unless this is exactly "1":
#
#   ALLOW_SEED=1 npm run db:seed
#
ALLOW_SEED="0"

# ─── Injected by the platform — do not set these by hand ─────────────────────

# Vercel sets these automatically. `VERCEL_OIDC_TOKEN` is present on Vercel
# deployments, which is exactly why `src/lib/storage.ts` passes
# `BLOB_READ_WRITE_TOKEN` to the SDK explicitly on every call: left to itself the
# SDK prefers OIDC and would pick the store named by `BLOB_STORE_ID` instead.
# BLOB_STORE_ID="store_..."
# VERCEL_OIDC_TOKEN="..."

# `NODE_ENV` is set by Next.js itself (`development` / `production`) and drives
# HSTS, log verbosity and the secure-cookie flags. Do not set it manually.
